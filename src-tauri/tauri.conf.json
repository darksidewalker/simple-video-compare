{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dasiwa-simple-video-compare",
  "version": "0.3.0",
  "identifier": "com.dasiwa.simple-video-compare",
  "build": {
    "beforeBuildCommand": "npm --prefix ../desktop run build",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DaSiWa Simple Video Compare",
        "width": 1600,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "createUpdaterArtifacts": false
  }
}
